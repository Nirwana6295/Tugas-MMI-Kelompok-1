# ========================================================
# GeoSpatialX MMI — Railway Environment Variables Example
# ========================================================

# PostgreSQL with PostGIS Connection URL
# On Railway: Add a 'PostgreSQL' service to your project, then reference:
# DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://postgres:password@host:port/railway?schema=public"

# Google Maps Platform API Key (for 3-Level Maps & Satellite Imagery)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# NextAuth / Session Secret Key
NEXTAUTH_SECRET="geospatialx-mmi-production-secret-token-key-2026"

# NextAuth URL (In Railway, set to your Railway public domain, e.g. https://geospatialx.up.railway.app)
NEXTAUTH_URL="https://${RAILWAY_PUBLIC_DOMAIN}"

# Node Environment
NODE_ENV="production"
PORT=3000
